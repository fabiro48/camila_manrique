<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>

    <main style="max-width: 600px; margin: 80px auto; padding: 0 20px;">
        <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px;">
            <a href="/products" style="color: var(--text-muted); text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 20px;">← Volver al catálogo</a>
            <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 8px; color: var(--text-main);">Editar Bolso / Producto</h2>
            <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 30px;">Modifica los datos del bolso o accesorio en el catálogo.</p>

            <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                <div style="background: rgba(225,29,72,0.1); border: 1px solid #e11d48; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
                    <% errors.forEach(err => { %>
                        <p style="color: #e11d48; font-size: 13px; margin: 2px 0;">⚠ <%= typeof err === 'object' ? err.msg : err %></p>
                    <% }) %>
                </div>
            <% } %>

            <%
                const cats = typeof categories !== 'undefined' && categories
                    ? categories
                    : ['Tote', 'Bandolera', 'Morral', 'Mini Bag', 'Cartera', 'Clutch', 'Otro'];
            %>

            <form id="productForm" action="/products/<%= product.id %>?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="name">Nombre del bolso / accesorio</label>
                    <input type="text" id="name" name="name" maxlength="100" value="<%= typeof oldData !== 'undefined' && oldData ? oldData.name : (typeof product !== 'undefined' && product ? product.name : '') %>" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="description">Descripción</label>
                    <input type="text" id="description" name="description" maxlength="255" value="<%= typeof oldData !== 'undefined' && oldData ? oldData.description : (typeof product !== 'undefined' && product ? product.description : '') %>" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="price">Precio (COP)</label>
                    <input type="number" id="price" name="price" min="0.01" max="9999999" step="0.01" value="<%= typeof oldData !== 'undefined' && oldData ? oldData.price : (typeof product !== 'undefined' && product ? product.price : '') %>" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="category">Categoría</label>
                    <select id="category" name="category" required style="width:100%; padding:10px; background:var(--bg-color); border:1px solid var(--border-color); border-radius:6px; color:#fff; font-size:13px;">
                        <option value="" disabled <%= (typeof oldData === 'undefined' || !oldData) && (typeof product === 'undefined' || !product || !product.category) ? 'selected' : '' %>>Selecciona una categoría</option>
                        <% cats.forEach(cat => { %>
                            <option value="<%= cat %>" <%= (typeof oldData !== 'undefined' && oldData && oldData.category === cat) || (typeof product !== 'undefined' && product && product.category === cat) ? 'selected' : '' %>><%= cat %></option>
                        <% }) %>
                    </select>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="image">URL de imagen</label>
                    <input type="url" id="image" name="image" maxlength="500" value="<%= typeof oldData !== 'undefined' && oldData ? oldData.image : (typeof product !== 'undefined' && product ? product.image : '') %>">
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="inOffer" name="inOffer" value="on" style="width:auto; cursor:pointer;" <%= (typeof oldData !== 'undefined' && oldData && oldData.inOffer) || (typeof oldData === 'undefined' || !oldData) && (typeof product !== 'undefined' && product && product.inOffer) ? 'checked' : '' %>>
                    <label for="inOffer" style="margin-bottom: 0; cursor: pointer;">¿Está en oferta?</label>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 24px;">
                    <button type="submit" class="btn-agendar" style="flex: 1;">Actualizar Producto</button>
                    <a href="/products" style="flex:1; display:inline-block; text-align:center; padding:10px 20px; border-radius:6px; border:1px solid var(--border-color); color:var(--text-muted); text-decoration:none; font-size:14px; font-weight:600;">Cancelar</a>
                </div>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
    <script src="/js/validations.js"></script>
</body>
</html>
