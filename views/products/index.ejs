<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>

    <main style="max-width: 1000px; margin: 60px auto; padding: 0 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 12px;">
            <h2 style="font-size: 28px; font-weight: 700;">Catálogo de Productos</h2>
            <div style="display:flex; gap:12px; align-items:center;">
                <form action="/products" method="GET" style="display:flex; gap:8px;">
                    <input type="text" name="q" placeholder="Buscar..." value="<%= typeof q !== 'undefined' ? q : '' %>"
                        style="padding:8px 12px; background:var(--card-bg); border:1px solid var(--border-color); border-radius:6px; color:#fff; font-size:13px; width:180px;">
                    <button type="submit" style="padding:8px 14px; background:var(--border-color); border:none; color:#fff; border-radius:6px; cursor:pointer; font-size:13px;">🔍</button>
                </form>
                <% if (locals.sessionUser && sessionUser.rol === 'admin') { %>
                    <a href="/products/create" class="btn-agendar">+ Agregar Bolso</a>
                <% } %>
            </div>
        </div>

        <% if (products.length === 0) { %>
            <p style="color: var(--text-muted); text-align: center; padding: 60px 0;">No hay productos registrados aún.</p>
        <% } else { %>
            <div class="services-grid">
                <% products.forEach(product => { %>
                    <div class="service-card">
                        <% if (product.imagen) { %>
                            <img src="<%= product.imagen %>" alt="<%= product.nombre %>" onerror="this.src='https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=400&q=80'">
                        <% } else { %>
                            <img src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=400&q=80" alt="<%= product.nombre %>">
                        <% } %>
                        <div class="service-card-content" style="flex-direction: column; align-items: flex-start; gap: 10px;">
                            <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                <h4><%= product.nombre %></h4>
                                <% if (product.inOffer) { %>
                                    <span style="background: #e11d48; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 10px; font-weight: bold;">OFERTA</span>
                                <% } %>
                            </div>
                            <span class="price-tag">$<%= parseFloat(product.precio).toLocaleString('es-CO') %></span>
                            <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                                <%= product.descripcion ? product.descripcion.substring(0, 80) + '...' : '' %>
                            </p>
                            <div style="display: flex; gap: 8px; width: 100%; margin-top: 6px; flex-wrap: wrap;">
                                <a href="/products/<%= product.id %>" style="flex:1; min-width:60px; text-align:center; padding:7px; border-radius:6px; border:1px solid var(--border-color); color:var(--text-muted); text-decoration:none; font-size:12px;">Ver</a>

                                <% if (locals.sessionUser && sessionUser.rol !== 'admin') { %>
                                    <form action="/cart/add" method="POST" style="flex:1; min-width:60px;">
                                        <input type="hidden" name="productId" value="<%= product.id %>">
                                        <input type="hidden" name="cantidad" value="1">
                                        <button type="submit" style="width:100%; padding:7px; border-radius:6px; background:var(--accent-gold); color:#000; border:none; font-size:12px; font-weight:600; cursor:pointer;">🛒 Carrito</button>
                                    </form>
                                <% } %>

                                <% if (locals.sessionUser && sessionUser.rol === 'admin') { %>
                                    <a href="/products/<%= product.id %>/edit" style="flex:1; min-width:60px; text-align:center; padding:7px; border-radius:6px; background:var(--border-color); color:#fff; text-decoration:none; font-size:12px; font-weight:600;">Editar</a>
                                    <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="flex:1; min-width:60px;" onsubmit="return confirm('¿Eliminar este producto?')">
                                        <button type="submit" style="width:100%; padding:7px; border-radius:6px; background:transparent; border:1px solid #e11d48; color:#e11d48; font-size:12px; cursor:pointer;">Eliminar</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
