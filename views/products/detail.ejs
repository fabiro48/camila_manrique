<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>

    <main style="max-width: 800px; margin: 60px auto; padding: 0 20px;">
        <a href="/products" style="color: var(--text-muted); text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 24px;">← Volver al catálogo</a>

        <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; gap: 0;">
            <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 100%; height: 380px; object-fit: cover;">
            <div style="padding: 40px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                        <span style="background: var(--border-color); color: var(--text-muted); padding: 4px 10px; border-radius: 4px; font-size: 11px;">
                            <%= product.category %>
                        </span>
                        <% if (product.inOffer) { %>
                            <span style="background: #e11d48; color: #fff; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: bold;">EN OFERTA</span>
                        <% } %>
                    </div>
                    <h2 style="font-size: 26px; font-weight: 700; margin-bottom: 16px;"><%= product.name %></h2>
                    <p style="color: var(--text-muted); font-size: 14px; line-height: 1.7; margin-bottom: 24px;"><%= product.description %></p>
                    <p style="font-size: 28px; font-weight: 800; color: var(--accent-gold);">
                        $<%= product.price.toLocaleString('es-CO') %>
                    </p>
                </div>
                <div style="display: flex; gap: 12px; margin-top: 30px;">
                    <a href="/products/<%= product.id %>/edit" class="btn-agendar" style="flex: 1; text-align: center; text-decoration: none;">Editar</a>
                    <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="flex: 1;" onsubmit="return confirm('¿Eliminar este producto?')">
                        <button type="submit" style="width:100%; padding: 10px 20px; border-radius: 6px; background: transparent; border: 1px solid #e11d48; color: #e11d48; font-size: 14px; font-weight: 600; cursor: pointer;">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
