<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>

    <main style="max-width: 800px; margin: 60px auto; padding: 0 20px;">
        <a href="/products" style="color: var(--text-muted); text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 24px;">← Volver al catálogo</a>

        <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr;">
            <% if (product.imagen) { %>
                <img src="<%= product.imagen %>" alt="<%= product.nombre %>"
                    style="width: 100%; height: 380px; object-fit: cover;"
                    onerror="this.src='https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=400&q=80'">
            <% } else { %>
                <img src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=400&q=80" alt="<%= product.nombre %>" style="width:100%; height:380px; object-fit:cover;">
            <% } %>

            <div style="padding: 40px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                        <span style="background: var(--border-color); color: var(--text-muted); padding: 4px 10px; border-radius: 4px; font-size: 11px;">
                            <%= product.category ? product.category.nombre : 'Sin categoría' %>
                        </span>
                        <% if (product.inOffer) { %>
                            <span style="background: #e11d48; color: #fff; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: bold;">EN OFERTA</span>
                        <% } %>
                    </div>
                    <h2 style="font-size: 26px; font-weight: 700; margin-bottom: 16px;"><%= product.nombre %></h2>
                    <p style="color: var(--text-muted); font-size: 14px; line-height: 1.7; margin-bottom: 16px;"><%= product.descripcion %></p>
                    <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 24px;">
                        Stock disponible: <strong style="color:var(--text-main);"><%= product.stock %></strong>
                    </p>
                    <p style="font-size: 28px; font-weight: 800; color: var(--accent-gold);">
                        $<%= parseFloat(product.precio).toLocaleString('es-CO') %>
                    </p>
                </div>

                <div style="display: flex; flex-direction:column; gap: 10px; margin-top: 30px;">
                    <% if (locals.sessionUser && sessionUser.rol !== 'admin') { %>
                        <form action="/cart/add" method="POST">
                            <input type="hidden" name="productId" value="<%= product.id %>">
                            <input type="hidden" name="cantidad" value="1">
                            <button type="submit" class="btn-agendar" style="width:100%;">🛒 Agregar al carrito</button>
                        </form>
                    <% } else if (!locals.sessionUser) { %>
                        <a href="/users/login" class="btn-agendar" style="text-align:center; text-decoration:none;">Inicia sesión para comprar</a>
                    <% } %>

                    <% if (locals.sessionUser && sessionUser.rol === 'admin') { %>
                        <div style="display:flex; gap:10px; margin-top:4px;">
                            <a href="/products/<%= product.id %>/edit" style="flex:1; text-align:center; padding:10px; border-radius:6px; background:var(--border-color); color:#fff; text-decoration:none; font-size:13px; font-weight:600;">Editar</a>
                            <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="flex:1;" onsubmit="return confirm('¿Eliminar este producto?')">
                                <button type="submit" style="width:100%; padding:10px; border-radius:6px; background:transparent; border:1px solid #e11d48; color:#e11d48; font-size:13px; font-weight:600; cursor:pointer;">Eliminar</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
