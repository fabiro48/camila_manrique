<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>

    <main style="max-width: 480px; margin: 80px auto; padding: 0 20px;">
        <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px;">
            <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 6px;">Crear cuenta</h2>
            <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 28px;">Regístrate para acceder a tu perfil en Camila Manrique.</p>

            <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                <div style="background: rgba(225,29,72,0.1); border: 1px solid #e11d48; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
                    <% errors.forEach(err => { %>
                        <p style="color: #e11d48; font-size: 13px; margin: 2px 0;">⚠ <%= typeof err === 'object' ? err.msg : err %></p>
                    <% }) %>
                </div>
            <% } %>

            <form id="registerForm" action="/users/register" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="nombre">Nombre</label>
                    <input type="text" id="nombre" name="nombre" placeholder="Ej: Laura" value="<%= typeof oldData !== 'undefined' && oldData ? oldData.nombre : '' %>" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="apellido">Apellido</label>
                    <input type="text" id="apellido" name="apellido" placeholder="Ej: Martínez" value="<%= typeof oldData !== 'undefined' && oldData ? oldData.apellido : '' %>" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="email" placeholder="correo@ejemplo.com" value="<%= typeof oldData !== 'undefined' && oldData ? oldData.email : '' %>" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" placeholder="Mínimo 8 caracteres" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirmar contraseña</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repite tu contraseña" required>
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <div class="form-group">
                    <label for="image">Foto de perfil (opcional)</label>
                    <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp"
                        style="padding: 8px; background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-muted); font-size: 13px; width: 100%;">
                    <div class="error-msg" style="color: #e11d48; font-size: 12px; margin-top: 4px;"></div>
                </div>

                <button type="submit" class="btn-agendar" style="width: 100%; margin-top: 10px;">Crear cuenta</button>
            </form>

            <p style="text-align: center; margin-top: 20px; font-size: 13px; color: var(--text-muted);">
                ¿Ya tienes cuenta? <a href="/users/login" style="color: var(--accent-gold); text-decoration: none;">Inicia sesión</a>
            </p>
        </div>
    </main>

    <%- include('../partials/footer') %>
    <script src="/js/validations.js"></script>
</body>
</html>
