<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>

    <main style="max-width: 480px; margin: 80px auto; padding: 0 20px;">
        <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px;">
            <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 6px;">Crear cuenta</h2>
            <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 28px;">Regístrate para acceder a tu perfil en Camila Manrique.</p>

            <% if (errors && errors.length > 0) { %>
                <div style="background:rgba(225,29,72,0.1); border:1px solid #e11d48; border-radius:8px; padding:12px 16px; margin-bottom:20px;">
                    <% errors.forEach(err => { %>
                        <p style="color:#e11d48; font-size:13px; margin:2px 0;">⚠ <%= err %></p>
                    <% }) %>
                </div>
            <% } %>

            <form id="registerForm" action="/users/register" method="POST" enctype="multipart/form-data" novalidate>
                <div class="form-group">
                    <label for="nombre">Nombre</label>
                    <input type="text" id="nombre" name="nombre"
                        value="<%= (typeof body !== 'undefined' && body.nombre) ? body.nombre : '' %>"
                        placeholder="Ej: Laura">
                    <span class="field-error" id="err-nombre"></span>
                </div>

                <div class="form-group">
                    <label for="apellido">Apellido</label>
                    <input type="text" id="apellido" name="apellido"
                        value="<%= (typeof body !== 'undefined' && body.apellido) ? body.apellido : '' %>"
                        placeholder="Ej: Martínez">
                    <span class="field-error" id="err-apellido"></span>
                </div>

                <div class="form-group">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="email"
                        value="<%= (typeof body !== 'undefined' && body.email) ? body.email : '' %>"
                        placeholder="correo@ejemplo.com">
                    <span class="field-error" id="err-email"></span>
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" placeholder="Mínimo 6 caracteres con al menos 1 número">
                    <span class="field-error" id="err-password"></span>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirmar contraseña</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repite tu contraseña">
                    <span class="field-error" id="err-confirm"></span>
                </div>

                <div class="form-group">
                    <label for="image">Foto de perfil (opcional)</label>
                    <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp"
                        style="padding:8px; background:var(--bg-color); border:1px solid var(--border-color); border-radius:6px; color:var(--text-muted); font-size:13px; width:100%;">
                    <span class="field-error" id="err-image"></span>
                </div>

                <button type="submit" class="btn-agendar" style="width:100%; margin-top:10px;">Crear cuenta</button>
            </form>

            <p style="text-align:center; margin-top:20px; font-size:13px; color:var(--text-muted);">
                ¿Ya tienes cuenta? <a href="/users/login" style="color:var(--accent-gold); text-decoration:none;">Inicia sesión</a>
            </p>
        </div>
    </main>

    <style>
        .field-error { color: #e11d48; font-size: 11px; display: block; margin-top: 4px; min-height: 14px; }
    </style>

    <script>
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            let valid = true;
            document.querySelectorAll('.field-error').forEach(el => { el.textContent = ''; });
            const setError = (id, msg) => { document.getElementById(id).textContent = msg; valid = false; };

            const nombre = document.getElementById('nombre').value.trim();
            if (!nombre || nombre.length < 2) setError('err-nombre', 'El nombre debe tener al menos 2 caracteres.');
            else if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(nombre)) setError('err-nombre', 'El nombre solo puede contener letras.');

            const apellido = document.getElementById('apellido').value.trim();
            if (!apellido || apellido.length < 2) setError('err-apellido', 'El apellido debe tener al menos 2 caracteres.');
            else if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(apellido)) setError('err-apellido', 'El apellido solo puede contener letras.');

            const email = document.getElementById('email').value.trim();
            if (!email) setError('err-email', 'El correo es obligatorio.');
            else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) setError('err-email', 'El correo no tiene un formato válido.');

            const password = document.getElementById('password').value;
            if (!password || password.length < 6) setError('err-password', 'La contraseña debe tener al menos 6 caracteres.');
            else if (!/\d/.test(password)) setError('err-password', 'La contraseña debe contener al menos un número.');

            const confirm = document.getElementById('confirmPassword').value;
            if (confirm !== password) setError('err-confirm', 'Las contraseñas no coinciden.');

            const imageFile = document.getElementById('image').files[0];
            if (imageFile && imageFile.size > 2 * 1024 * 1024) setError('err-image', 'La imagen no puede superar 2MB.');

            if (!valid) e.preventDefault();
        });
    </script>

    <%- include('../partials/footer') %>
</body>
</html>
