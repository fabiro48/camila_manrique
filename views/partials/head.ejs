<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camila Manrique — Marroquinería & Bolsos Exclusivos</title>
    <style>
        :root {
            --bg-color: #0b0f17;
            --card-bg: #111622;
            --accent-gold: #f0c36b;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
            --border-color: #262c36;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* --- HEADER & NAVBAR --- */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 60px;
            background-color: var(--bg-color);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: bold;
            font-size: 14px;
            letter-spacing: 1px;
        }

        .logo-container img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--accent-gold);
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul li a {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 14px;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: var(--accent-gold);
        }

        .btn-agendar {
            background-color: var(--accent-gold);
            color: #000;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .btn-agendar:hover {
            opacity: 0.9;
        }

        /* --- HERO SECTION --- */
        .hero {
            position: relative;
            text-align: center;
            padding: 80px 20px 140px;
            background: linear-gradient(rgba(11, 15, 23, 0.85), rgba(11, 15, 23, 0.95)), url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
        }

        .hero h1 {
            font-size: 42px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 10px;
            color: #fff;
        }

        .hero h2 {
            font-size: 22px;
            font-weight: 400;
            color: var(--accent-gold);
            margin-bottom: 15px;
        }

        .hero p.schedule-info {
            font-size: 16px;
            color: var(--text-muted);
            margin-bottom: 10px;
        }

        .hero p.location-info {
            font-size: 13px;
            color: #64748b;
            line-height: 1.4;
        }

        /* --- SOBRE NOSOTROS & IMAGENES FLOTANTES --- */
        .about-section {
            max-width: 900px;
            margin: -60px auto 60px;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 40px;
            align-items: center;
            position: relative;
            z-index: 2;
        }

        .about-images {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .about-images img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .about-text h3 {
            font-size: 32px;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .about-text p {
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        /* --- HORARIOS DISPONIBLES TABLA --- */
        .schedule-section {
            max-width: 800px;
            margin: 60px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

        .schedule-section img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            border-radius: 8px;
        }

        .schedule-table-container h3 {
            font-size: 24px;
            margin-bottom: 20px;
            letter-spacing: 0.5px;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
        }

        .schedule-table th, .schedule-table td {
            padding: 8px 0;
            font-size: 14px;
            text-align: left;
        }

        .schedule-table th {
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-color);
            font-weight: 500;
        }

        .schedule-table td {
            color: #cbd5e1;
        }

        /* --- SERVICIOS --- */
        .services-section {
            background-color: #fff;
            color: #000;
            padding: 60px 20px;
            margin: 40px 0;
        }

        .services-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .services-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .services-header h2 {
            font-size: 32px;
            font-weight: 800;
        }

        .services-banner-desc {
            background: #f1f5f9;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            font-size: 13px;
            color: #475569;
            margin-bottom: 40px;
            border: 1px solid #e2e8f0;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .service-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        .service-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .service-card-content {
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .service-card-content h4 {
            font-size: 14px;
            font-weight: 600;
        }

        .price-tag {
            background: #000;
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
        }

        /* --- COLABORADORES --- */
        .collab-section {
            max-width: 1000px;
            margin: 80px auto;
            padding: 0 20px;
            display: flex;
            gap: 40px;
            align-items: center;
        }

        .collab-title-vertical {
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            font-size: 28px;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 2px;
            text-align: center;
        }

        .collab-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            width: 100%;
        }

        .collab-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
            padding-bottom: 20px;
        }

        .collab-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            margin-bottom: 15px;
        }

        .collab-card h4 {
            font-size: 15px;
            color: var(--accent-gold);
            margin-bottom: 10px;
        }

        .stars {
            color: var(--accent-gold);
            font-size: 12px;
            margin-bottom: 15px;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 15px;
            color: var(--text-muted);
            font-size: 14px;
        }

        /* --- TESTIMONIOS (CLIENTES) --- */
        .testimonials-section {
            max-width: 1000px;
            margin: 80px auto;
            padding: 0 20px;
        }

        .testimonials-section h2 {
            font-size: 28px;
            margin-bottom: 40px;
            font-weight: 700;
        }

        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .testimonial-card {
            background: #fff;
            color: #000;
            padding: 25px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .t-stars {
            color: #fbbf24;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .t-rating-number {
            font-size: 12px;
            font-weight: bold;
            color: #64748b;
            margin-bottom: 15px;
        }

        .testimonial-card p {
            font-size: 13px;
            color: #334155;
            line-height: 1.5;
            margin-bottom: 25px;
        }

        .client-info {
            display: flex;
            align-items: center;
            gap: 12px;
            border-top: 1px solid #f1f5f9;
            padding-top: 15px;
        }

        .client-info img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
        }

        .client-info h5 {
            font-size: 13px;
            font-weight: bold;
        }

        .client-info span {
            font-size: 11px;
            color: #64748b;
        }

        /* --- FOOTER --- */
        footer {
            background: #070a0f;
            border-top: 1px solid var(--border-color);
            padding: 60px 20px 30px;
            color: var(--text-muted);
            font-size: 13px;
        }

        .footer-content {
            max-width: 1000px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 2fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-brand p {
            margin-top: 15px;
            font-size: 12px;
            color: #64748b;
        }

        .footer-links h5, .footer-contact h5 {
            color: #fff;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .footer-links ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .footer-links ul li a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13px;
        }

        .footer-contact p {
            margin-bottom: 8px;
            font-size: 12px;
        }

        .footer-bottom {
            max-width: 1000px;
            margin: 0 auto;
            border-top: 1px solid var(--border-color);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: #64748b;
        }

        /* --- MODAL AGENDAMIENTO --- */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            width: 380px;
            padding: 30px;
            border-radius: 12px;
            position: relative;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-header h3 {
            font-size: 18px;
            font-weight: bold;
        }

        .close-btn {
            background: none;
            border: none;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 10px;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: #fff;
            font-size: 13px;
        }

        .time-slots {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-top: 5px;
        }

        .time-slot {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 6px 0;
            text-align: center;
            font-size: 11px;
            border-radius: 4px;
            cursor: pointer;
        }

        .time-slot.selected {
            background: var(--accent-gold);
            color: #000;
            font-weight: bold;
            border-color: var(--accent-gold);
        }

        .modal .btn-agendar {
            width: 100%;
            margin-top: 15px;
        }

        /* Pantalla de Exito Oculta inicialmente dentro del modal o flujo */
        .success-view {
            text-align: center;
            display: none;
            padding: 20px 0;
        }

        .success-view img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid var(--accent-gold);
            margin-bottom: 15px;
        }

        .success-view h4 {
            font-size: 16px;
            margin-bottom: 20px;
        }
    </style>
</head>