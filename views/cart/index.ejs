<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>

    <main style="max-width: 800px; margin: 60px auto; padding: 0 20px;">
        <h2 style="font-size: 28px; font-weight: 700; margin-bottom: 30px;">🛒 Mi Carrito</h2>

        <% if (cart.length === 0) { %>
            <div style="text-align: center; padding: 80px 0; color: var(--text-muted);">
                <p style="font-size: 48px; margin-bottom: 20px;">🛍️</p>
                <p style="font-size: 16px; margin-bottom: 24px;">Tu carrito está vacío.</p>
                <a href="/products" class="btn-agendar">Ver colección</a>
            </div>
        <% } else { %>
            <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px;">
                <% cart.forEach(item => { %>
                    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 20px;">
                        <% if (item.imagen) { %>
                            <img src="<%= item.imagen %>" alt="<%= item.nombre %>"
                                style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; flex-shrink: 0;"
                                onerror="this.style.display='none'">
                        <% } else { %>
                            <div style="width:80px; height:80px; background:var(--border-color); border-radius:8px; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:var(--text-muted);">👜</div>
                        <% } %>
                        <div style="flex: 1;">
                            <h4 style="font-size: 15px; font-weight: 600; margin-bottom: 6px;"><%= item.nombre %></h4>
                            <p style="color: var(--accent-gold); font-size: 14px; font-weight: 700;">
                                $<%= (item.precio * item.cantidad).toLocaleString('es-CO') %>
                            </p>
                            <p style="color: var(--text-muted); font-size: 12px;">
                                $<%= item.precio.toLocaleString('es-CO') %> × <%= item.cantidad %>
                            </p>
                        </div>
                        <form action="/cart/remove" method="POST">
                            <input type="hidden" name="productId" value="<%= item.productId %>">
                            <button type="submit" style="background: transparent; border: 1px solid #e11d48; color: #e11d48; padding: 6px 14px; border-radius: 6px; font-size: 12px; cursor: pointer;">
                                Quitar
                            </button>
                        </form>
                    </div>
                <% }) %>
            </div>

            <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <span style="font-size: 16px; color: var(--text-muted);">Total del pedido:</span>
                    <span style="font-size: 24px; font-weight: 800; color: var(--accent-gold);">
                        $<%= total.toLocaleString('es-CO') %>
                    </span>
                </div>
                <form action="/cart/checkout" method="POST" onsubmit="return confirm('¿Confirmar el pedido?')">
                    <button type="submit" class="btn-agendar" style="width: 100%; font-size: 15px; padding: 14px;">
                        ✅ Confirmar Pedido
                    </button>
                </form>
                <a href="/products" style="display:block; text-align:center; margin-top:12px; color:var(--text-muted); font-size:13px; text-decoration:none;">
                    ← Seguir comprando
                </a>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
